// npx prisma migrate dev --name init
generator client {
    provider   = "prisma-client-js"
    engineType = "binary"
}

datasource db {
    provider = "mysql"
    // url      = env("DATABASE_URL")
}

model User {
    id          Int          @id @default(autoincrement())
    name        String
    email       String       @unique
    password    String
    role        Role         @default(Employee)
    positionId  Int
    createdAt   DateTime     @default(now())
    tasks       Task[]
    attendances Attendance[]
    leaves      Leave[]
    payrolls    Payroll[]
    workPolicy  WorkPolicy?
}

enum Role {
    Admin
    Manager
    Employee
}

model Position {
    id        Int      @id @default(autoincrement())
    name      String   @unique
    salary    Float
    createdAt DateTime @default(now())
}

model Task {
    id        Int        @id @default(autoincrement())
    title     String
    status    TaskStatus @default(TODO)
    dueDate   DateTime?
    userId    Int
    createdAt DateTime   @default(now())

    user User @relation(fields: [userId], references: [id])
}

enum TaskStatus {
    TODO
    IN_PROGRESS
    DONE
}

model Attendance {
    id        Int       @id @default(autoincrement())
    userId    Int
    checkIn   DateTime?
    checkOut  DateTime?
    date      DateTime
    createdAt DateTime  @default(now())

    user User @relation(fields: [userId], references: [id])
}

model Leave {
    id        Int         @id @default(autoincrement())
    userId    Int
    reason    String
    status    LeaveStatus @default(PENDING)
    startDate DateTime
    endDate   DateTime
    createdAt DateTime    @default(now())

    user User @relation(fields: [userId], references: [id])
}

enum LeaveStatus {
    PENDING
    APPROVED
    REJECTED
}

model WorkPolicy {
    id              Int      @id @default(autoincrement())
    userId          Int      @unique
    monthlySalary   Float
    workHoursPerDay Float    @default(8)
    workDaysPerWeek Int      @default(5)
    createdAt       DateTime @default(now())

    user User @relation(fields: [userId], references: [id])
}

model Payroll {
    id              Int      @id @default(autoincrement())
    userId          Int
    month           String
    baseSalary      Float
    hoursWorkPerDay Float
    daysWorkPerWeek Int
    workedHours     Float
    workedDays      Int
    salary          Float
    bonus           Float
    tax             Float
    netSalary       Float
    createdAt       DateTime @default(now())

    user User @relation(fields: [userId], references: [id])
}
