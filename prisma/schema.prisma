// npx prisma migrate dev --name 
generator client {
    provider   = "prisma-client-js"
    engineType = "binary"
}

datasource db {
    provider = "mysql"
    // url      = env("DATABASE_URL")
}

model User {
    id        Int      @id @default(autoincrement())
    name      String
    email     String   @unique
    password  String
    createdAt DateTime @default(now())
}
